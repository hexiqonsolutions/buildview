{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/notifications?task=flush",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/internal/notifications?task=digest&slot=midday",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/internal/notifications?task=digest&slot=evening",
      "schedule": "30 13 * * *"
    }
  ]
}

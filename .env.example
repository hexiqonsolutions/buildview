# =============================================================================
# BuildView — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#
#   cp .env.example .env.local
#
# On Vercel, add the same variables in Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Public project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (SERVER ONLY — never expose to the client or commit to git)
# Used for privileged server operations that bypass RLS when needed.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection for `npm run db:apply -- <migration numbers>` (Dashboard → Database → URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Application URL (required for auth email links in production)
# -----------------------------------------------------------------------------

# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example (uncomment and set your Vercel domain):
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Public site URL for SEO (sitemap, Open Graph) and links in notification emails.
# Defaults to NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_SITE_URL=https://buildview.io
# Until the custom domain is live, set this to the production Vercel URL so
# Open Graph, sitemap, and canonical tags do not point at a parked domain.
# NEXT_PUBLIC_SITE_URL=https://buildview-tawny.vercel.app

# -----------------------------------------------------------------------------
# Integrations (optional)
# -----------------------------------------------------------------------------

# Background sync security (required for cron/webhooks)
# Internal jobs like /api/internal/sync-users reject every request until this is
# set; callers must send Authorization: Bearer <CRON_SECRET> (Vercel Cron does so
# automatically). Generate with: openssl rand -hex 32
# CRON_SECRET=your-random-long-secret

# Calendly — embed scheduler on /contact (use your Calendly inline embed URL)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/buildview-demo?embed_domain=localhost:3000&embed_type=Inline

# Google Analytics 4 measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID only — never put a Conversions API access token in NEXT_PUBLIC_* vars
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# META_CAPI_ACCESS_TOKEN=your-server-only-conversions-api-token
# META_CAPI_TEST_EVENT_CODE=TEST12345

# Resend — contact form email delivery (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=hello@buildview.io
# CONTACT_FROM_EMAIL=BuildView <notifications@yourdomain.com>

# Optional — separate sender for in-app notification emails (falls back to CONTACT_FROM_EMAIL)
# NOTIFICATION_FROM_EMAIL=BuildView Alerts <alerts@yourdomain.com>

# -----------------------------------------------------------------------------
# Rate limiting (optional — sensible defaults in src/lib/rate-limit/config.ts)
# Counters are stored in Supabase (migration 028_rate_limits.sql). Without that
# migration the app falls back to per-instance memory limits.
# -----------------------------------------------------------------------------

# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORE=database            # or "memory" (single instance / local dev)

# Override any threshold with RATE_LIMIT_<POLICY>_<FIELD>.
#
# Auth policies use exponential backoff (no hard lockout): the first
# FREE_ATTEMPTS are free, then waits of BASE_DELAY, 2×, 4×… up to MAX_DELAY.
# The count is forgotten after RESET_AFTER seconds without new attempts.
# Fields: FREE_ATTEMPTS, BASE_DELAY_SECONDS, MAX_DELAY_SECONDS, RESET_AFTER_SECONDS
#   AUTH_LOGIN_IP                 (failed logins per IP)          default 20 / 30s / 1800s / 3600s
#   AUTH_LOGIN_ACCOUNT            (failed logins per email)       default  5 / 30s /  900s / 3600s
#   AUTH_SIGNUP_IP / _ACCOUNT     (sign-ups per IP / email)       default  5,3 / 60s / 3600s / 3600s
#   AUTH_PASSWORD_RESET_IP / _ACCOUNT  (reset emails)             default  5,3 / 60s,120s / 3600s / 3600s
#   AUTH_PASSWORD_UPDATE_IP / _ACCOUNT (set new password)         default 10,5 / 30s / 900s / 3600s
#   AUTH_OAUTH_IP                 (Google sign-in starts per IP)  default 10 / 15s / 600s / 1800s
#
# Public and signed-in policies use a fixed window.
# Fields: LIMIT, WINDOW_SECONDS
#   PUBLIC_API            (/api/* per IP)                         default  60 / 60s
#   PUBLIC_ACTION         (anonymous form posts per IP)           default  30 / 60s
#   PUBLIC_CONTACT        (contact form per IP)                   default   5 / 600s
#   PUBLIC_AUTH_CALLBACK  (/auth/callback per IP)                 default  20 / 300s
#   AUTHENTICATED         (actions + API per signed-in user)      default 300 / 60s
#
# Examples:
# RATE_LIMIT_AUTH_LOGIN_ACCOUNT_FREE_ATTEMPTS=3
# RATE_LIMIT_AUTHENTICATED_LIMIT=600
#
# Or set several at once as JSON (individual vars above take priority):
# RATE_LIMIT_POLICIES={"authLoginAccount":{"freeAttempts":3},"publicApi":{"limit":120}}
